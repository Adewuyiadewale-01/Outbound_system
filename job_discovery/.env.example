# Google Sheets transport. Apps Script is the recommended default.
# Deploy apps-script/Code.gs as a Web App bound to the target Sheet.
SHEETS_TRANSPORT=apps-script
GOOGLE_APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Alternative direct Sheets API transport (optional).
GOOGLE_SHEET_ID=1GrzMdQt6Irdmd5CmKI8HE_H_byeMVpsBhXDf_dRVmsg
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# Search source. "playwright-google" drives an on-screen browser. "fixture"
# supports a dry run; "google-cse" works only for an existing customer. "http"
# is for an adapter that returns { results: [{ title, link, snippet, displayLink? }] }.
SEARCH_PROVIDER=playwright-google
PLAYWRIGHT_HEADED=true
PLAYWRIGHT_CLI_PATH=
# Local persistent profile, retained across runs for normal cookies and consent state.
PLAYWRIGHT_PROFILE_DIR=./data/browser-profile
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SEARCH_API_URL=
SEARCH_API_TOKEN=

# Local is the recommended default. Set either source to "sheet" only when
# remote Sheet-based configuration is intentionally required.
CONTROL_SOURCE=local
CONFIGURATION_SOURCE=local
LOCAL_CONTROL_FILE=./config/runtime.json

# Local durable state. A .json path is automatically migrated to an indexed
# SQLite database with the same basename; the JSON file is retained as backup.
STATE_FILE=./data/state.json
